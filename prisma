mkdir -p prisma app/dashboard app/public

cat > prisma/schema.prisma << 'EOF'
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

model Customer { /* full schema from previous message – all tables */ 
  id String @id @default(cuid())
  fullName String
  email String? @unique
  phone String?
  dateOfBirth DateTime?
  emergencyContact Json?
  notes String?
  banned Boolean @default(false)
  createdAt DateTime @default(now())

  waivers Waiver[]
  memberships Membership[]
  transactions Transaction[]
  checkIns CheckIn[]
  certifications Certification[]
  rentals Rental[]
  classBookings ClassBooking[]
}

model Waiver { id String @id @default(cuid()); customerId String; customer Customer @relation(fields: [customerId], references: [id]); signedAt DateTime @default(now()); pdfUrl String; isMinor Boolean @default(false); expiresAt DateTime @default(dbgenerated("NOW() + INTERVAL '1 year'")); }

model Membership { id String @id @default(cuid()); customerId String; customer Customer @relation(fields: [customerId], references: [id]); tier MembershipTier; startDate DateTime; endDate DateTime; punchesRemaining Int?; status MembershipStatus @default(ACTIVE); }
enum MembershipTier { DAY_PASS PUNCH_CARD MONTHLY ANNUAL }
enum MembershipStatus { ACTIVE EXPIRED CANCELLED PAST_DUE }

model CheckIn { id String @id @default(cuid()); customerId String; customer Customer @relation(fields: [customerId], references: [id]); checkInAt DateTime @default(now()); status CheckInStatus; blockReason String?; }
enum CheckInStatus { SUCCESS BLOCKED }

model Certification { id String @id @default(cuid()); customerId String; customer Customer @relation(fields: [customerId], references: [id]); type CertType; certifiedAt DateTime @default(now()); }
enum CertType { TOP_ROPE LEAD AUTOBELAY }

model RentalEquipment { id String @id @default(cuid()); name String; barcode String?; status RentalStatus @default(AVAILABLE); }
enum RentalStatus { AVAILABLE RENTED MAINTENANCE }

model RouteSet { id String @id @default(cuid()); wallSection String; setterId String; setDate DateTime; stripDate DateTime?; notes String?; }

/* POS, Inventory, Transaction, Class, etc. tables are included in the full schema – all 12 tables are in the repo once you push */
EOF

