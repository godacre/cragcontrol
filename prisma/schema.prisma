model Class {
  id          String         @id @default(cuid())
  name        String
  startTime   DateTime
  endTime     DateTime
  instructorId String?
  instructor  Employee?      @relation(fields: [instructorId], references: [id])
  capacity    Int            @default(12)   // ← NEW
  description String?        // ← NEW
  checkIns    ClassCheckIn[]
}
